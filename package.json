{
  "name": "lab1",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "dev:auth": "yarn workspace auth-service run dev",
    "dev:user": "yarn workspace user-service run dev",
    "dev:gateway": "yarn workspace api-gateway run dev",
    "dev": "concurrently \"yarn dev:auth\" \"yarn dev:user\" \"yarn dev:gateway\"",
    "build": "yarn workspaces run build",
    "lint": "yarn workspaces run lint",
    "test": "yarn workspaces run test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "dotenv": "^16.4.7",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "ts-node-dev": "^2.0.0",
    "nodemon": "^3.1.9",
    "eslint": "^9.25.0",
    "prettier": "^3.5.3",
    "concurrently": "^8.0.1",
    "@types/node": "^22.13.0"
  }
}
